; Local validation input for GMX_FIXED_MOLECULAR_COM_FORCE_FILE.
; Keep this physically identical to the xm_050 NVT benchmark, but write forces every step.
integrator               = md
dt                       = 0.002
nsteps                   = 5
continuation             = yes
constraint-algorithm     = lincs
constraints              = all-bonds
lincs-iter               = 2
lincs-order              = 6
lincs-warnangle          = 30
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.4
coulombtype              = PME
rcoulomb                 = 1.4
vdwtype                  = Cut-off
rvdw                     = 1.4
DispCorr                 = EnerPres
pme-order                = 4
fourierspacing           = 0.12
ewald-rtol               = 1e-5
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 298.15
pcoupl                   = no
gen-vel                  = no
comm-mode                = None
nstcalcenergy            = 1
nstenergy                = 0
nstlog                   = 0
nstxout                  = 0
nstvout                  = 0
nstfout                  = 1
nstxout-compressed       = 0
